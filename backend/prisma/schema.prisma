// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  clientProfileId String   @unique @map("client_profile_id") @db.Uuid
  nickname        String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs              Run[]
  characterProgress UserCharacterProgress[]

  @@map("users")
}

model Character {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs         Run[]
  userProgress UserCharacterProgress[]

  @@map("characters")
}

model Item {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  rarity      String   @db.VarChar(32)
  isActive    Boolean  @default(true) @map("is_active")
  maxStacks   Int      @default(1) @map("max_stacks")
  effectData  Json     @default("[]") @map("effect_data") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  runItems RunItem[]

  @@map("items")
}

model Run {
  id                 String   @id @default(uuid()) @db.Uuid
  clientRunId        String   @unique @map("client_run_id") @db.Uuid
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  userId             String   @map("user_id") @db.Uuid
  characterId        String   @map("character_id") @db.VarChar(64)
  gameVersion        String   @map("game_version") @db.VarChar(32)
  startedAt          DateTime @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime @map("ended_at") @db.Timestamptz(3)
  playTime           Int      @map("play_time")
  reachedFloor       Int      @map("reached_floor")
  isCleared          Boolean  @map("is_cleared")
  killCount          Int      @default(0) @map("kill_count")
  deathReason        String?  @map("death_reason") @db.VarChar(32)
  experienceGained   Int      @default(0) @map("experience_gained")
  progressSnapshot   Json?    @map("progress_snapshot") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  character Character @relation(fields: [characterId], references: [id], onDelete: Restrict)
  runItems  RunItem[]

  @@index([userId], map: "runs_user_id_idx")
  @@index([characterId], map: "runs_character_id_idx")
  @@index([isCleared], map: "runs_is_cleared_idx")
  @@map("runs")
}

model UserCharacterProgress {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  characterId         String   @map("character_id") @db.VarChar(64)
  level               Int      @default(1)
  experience          Int      @default(0)
  skillPoints         Int      @default(0) @map("skill_points")
  lowGradeSkillLevel  Int      @default(1) @map("low_grade_skill_level")
  highGradeSkillLevel Int      @default(1) @map("high_grade_skill_level")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([userId, characterId], map: "user_character_progress_user_character_key")
  @@index([characterId], map: "user_character_progress_character_id_idx")
  @@map("user_character_progress")
}

model RunItem {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  itemId     String   @map("item_id") @db.VarChar(64)
  floor      Int
  acquiredAt DateTime @map("acquired_at") @db.Timestamptz(3)
  itemOrder  Int      @map("item_order")

  run  Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([runId, itemOrder], map: "run_items_run_id_item_order_key")
  @@index([itemId], map: "run_items_item_id_idx")
  @@map("run_items")
}
