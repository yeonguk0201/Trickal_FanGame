NODE_ENV=development
PORT=3001
# Server-only connection string. Development: Supabase session pooler. Production: Neon pooled connection.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres?schema=public
# Comma-separated Web origins allowed to call the API (production: the Vercel domain).
CORS_ORIGIN=http://localhost:3000
# Optional. Direct (non-pooled) connection for Prisma CLI migrations. Production: Neon direct connection.
# DIRECT_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
# Optional. Seeds the local `test-player`. Defaults to true outside production, false in production.
# SEED_TEST_USER=true
