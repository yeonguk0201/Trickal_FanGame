{
  "name": "trickal-fan-game",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"pnpm --dir backend start:dev\" \"pnpm --dir web dev\"",
    "dev:backend": "pnpm --dir backend start:dev",
    "dev:web": "pnpm --dir web dev",
    "db:push": "pnpm --dir backend prisma db push",
    "db:studio": "pnpm --dir backend prisma studio",
    "test": "pnpm --dir backend test",
    "install:all": "pnpm --dir backend install && pnpm --dir web install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "packageManager": "pnpm@11.21.0"
}
